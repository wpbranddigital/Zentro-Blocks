{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "zentro-blocks/container-block",
  "version": "1.0.0",
  "title": "Container",
  "category": "zentro-blocks",
  "icon": "editor-table",
  "description": "Flexible section wrapper with grid/flex layouts, custom background patterns, overlays, and spacing controls.",
  "keywords": [
    "container",
    "section",
    "columns",
    "layout",
    "grid"
  ],
  "textdomain": "zentro-blocks",
  "attributes": {
    "hasLayoutSelected": {
      "type": "boolean",
      "default": false
    },
    "selectedStructure": {
      "type": "string",
      "default": ""
    },
    "gridTemplateColumns": {
      "type": "string",
      "default": ""
    },
    "gridTemplateColumnsTablet": {
      "type": "string",
      "default": ""
    },
    "gridTemplateColumnsMobile": {
      "type": "string",
      "default": ""
    },
    "layoutType": {
      "type": "string",
      "default": "block"
    },
    "contentWidth": {
      "type": "string",
      "default": "boxed"
    },
    "maxWidth": {
      "type": "string",
      "default": "1200px"
    },
    "maxWidthTablet": {
      "type": "string",
      "default": "960px"
    },
    "maxWidthMobile": {
      "type": "string",
      "default": "100%"
    },
    "heightType": {
      "type": "string",
      "default": "auto"
    },
    "height": {
      "type": "string",
      "default": "auto"
    },
    "heightTablet": {
      "type": "string",
      "default": "auto"
    },
    "heightMobile": {
      "type": "string",
      "default": "auto"
    },
    "overflow": {
      "type": "string",
      "default": "visible"
    },
    "flexDirection": {
      "type": "string",
      "default": "row"
    },
    "flexDirectionTablet": {
      "type": "string",
      "default": "row"
    },
    "flexDirectionMobile": {
      "type": "string",
      "default": "column"
    },
    "justifyContent": {
      "type": "string",
      "default": "flex-start"
    },
    "justifyContentTablet": {
      "type": "string",
      "default": "flex-start"
    },
    "justifyContentMobile": {
      "type": "string",
      "default": "flex-start"
    },
    "alignItems": {
      "type": "string",
      "default": "stretch"
    },
    "alignItemsTablet": {
      "type": "string",
      "default": "stretch"
    },
    "alignItemsMobile": {
      "type": "string",
      "default": "stretch"
    },
    "flexWrap": {
      "type": "string",
      "default": "nowrap"
    },
    "gridColumns": {
      "type": "number",
      "default": 3
    },
    "gridColumnsTablet": {
      "type": "number",
      "default": 2
    },
    "gridColumnsMobile": {
      "type": "number",
      "default": 1
    },
    "gridRows": {
      "type": "number",
      "default": 1
    },
    "gridRowsTablet": {
      "type": "number",
      "default": 1
    },
    "gridRowsMobile": {
      "type": "number",
      "default": 1
    },
    "gap": {
      "type": "number",
      "default": 20
    },
    "gapTablet": {
      "type": "number",
      "default": 15
    },
    "gapMobile": {
      "type": "number",
      "default": 10
    },
    "rowGap": {
      "type": "number",
      "default": 20
    },
    "rowGapTablet": {
      "type": "number",
      "default": 15
    },
    "rowGapMobile": {
      "type": "number",
      "default": 10
    },
    "columnGap": {
      "type": "number",
      "default": 20
    },
    "columnGapTablet": {
      "type": "number",
      "default": 15
    },
    "columnGapMobile": {
      "type": "number",
      "default": 10
    },
    "gridAutoFit": {
      "type": "boolean",
      "default": false
    },
    "gridAutoFill": {
      "type": "boolean",
      "default": false
    },
    "gridTemplateAreas": {
      "type": "string",
      "default": ""
