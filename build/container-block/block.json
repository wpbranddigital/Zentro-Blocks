    "paddingTop": {
      "type": "number",
      "default": 40
    },
    "paddingTopTablet": {
      "type": "number",
      "default": 30
    },
    "paddingTopMobile": {
      "type": "number",
      "default": 20
    },
    "paddingBottom": {
      "type": "number",
      "default": 40
    },
    "paddingBottomTablet": {
      "type": "number",
      "default": 30
    },
    "paddingBottomMobile": {
      "type": "number",
      "default": 20
    },
    "paddingLeft": {
      "type": "number",
      "default": 20
    },
    "paddingLeftTablet": {
      "type": "number",
      "default": 15
    },
    "paddingLeftMobile": {
      "type": "number",
      "default": 10
    },
    "paddingRight": {
      "type": "number",
      "default": 20
    },
    "paddingRightTablet": {
      "type": "number",
      "default": 15
    },
    "paddingRightMobile": {
      "type": "number",
      "default": 10
    },
    "marginTop": {
      "type": "number",
      "default": 0
    },
    "marginTopTablet": {
      "type": "number",
      "default": 0
    },
    "marginTopMobile": {
      "type": "number",
      "default": 0
    },
    "marginBottom": {
      "type": "number",
      "default": 0
    },
    "marginBottomTablet": {
      "type": "number",
      "default": 0
    },
    "marginBottomMobile": {
      "type": "number",
      "default": 0
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "bgType": {
      "type": "string",
      "default": "color"
    },
    "bgGradient": {
      "type": "string",
      "default": ""
    },
    "backgroundImage": {
      "type": "string",
      "default": ""
    },
    "bgVideo": {
      "type": "string",
      "default": ""
    },
    "bgSlideshow": {
      "type": "array",
      "default": []
    },
    "backgroundPosition": {
      "type": "string",
      "default": "center center"
    },
    "backgroundSize": {
      "type": "string",
      "default": "cover"
    },
    "backgroundRepeat": {
      "type": "string",
      "default": "no-repeat"
    },
    "backgroundAttachment": {
      "type": "string",
      "default": "scroll"
    },
    "overlayColor": {
      "type": "string",
      "default": ""
    },
    "overlayGradient": {
      "type": "string",
      "default": ""
    },
    "overlayType": {
      "type": "string",
      "default": "color"
    },
    "overlayOpacity": {
      "type": "number",
      "default": 50
    },
    "borderRadiusTopLeft": {
      "type": "number",
      "default": 0
    },
    "borderRadiusTopRight": {
      "type": "number",
      "default": 0
    },
    "borderRadiusBottomLeft": {
      "type": "number",
      "default": 0
    },
    "borderRadiusBottomRight": {
      "type": "number",
      "default": 0
    },
    "borderWidth": {
      "type": "number",
      "default": 0
    },
    "borderStyle": {
      "type": "string",
      "default": "solid"
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "boxShadow": {
      "type": "boolean",
      "default": false
    },
    "shadowColor": {
      "type": "string",
      "default": "rgba(0,0,0,0.1)"
    },
    "shadowX": {
      "type": "number",
      "default": 0
    },
    "shadowY": {
      "type": "number",
      "default": 10
    },
    "shadowBlur": {
      "type": "number",
      "default": 30
    },
    "shadowSpread": {
      "type": "number",
      "default": 0
    },
    "shapeTopType": {
      "type": "string",
      "default": "none"
    },
    "shapeTopColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "shapeTopHeight": {
      "type": "number",
      "default": 80
    },
    "shapeTopWidth": {
      "type": "number",
      "default": 100
    },
    "shapeTopFlip": {
      "type": "boolean",
      "default": false
    },
    "shapeBottomType": {
      "type": "string",
      "default": "none"
    },
    "shapeBottomColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "shapeBottomHeight": {
      "type": "number",
      "default": 80
    },
    "shapeBottomWidth": {
      "type": "number",
      "default": 100
    },
    "shapeBottomFlip": {
      "type": "boolean",
      "default": false
    },
    "entranceAnimation": {
      "type": "string",
      "default": "none"
    },
    "scrollAnimation": {
      "type": "string",
      "default": "none"
    },
    "hoverAnimation": {
      "type": "string",
      "default": "none"
    },
    "visibilityDesktop": {
      "type": "boolean",
      "default": true
    },
    "visibilityTablet": {
      "type": "boolean",
      "default": true
    },
    "visibilityMobile": {
      "type": "boolean",
      "default": true
    },
    "visibilityRole": {
      "type": "string",
      "default": "all"
    },
    "containerLink": {
      "type": "string",
      "default": ""
    },
    "isSticky": {
      "type": "boolean",
      "default": false
    },
    "zIndex": {
      "type": "number",
      "default": 1
    },
    "customCss": {
      "type": "string",
      "default": ""
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "customClasses": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true
    }
  },
  "render": "file:./render.php",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}